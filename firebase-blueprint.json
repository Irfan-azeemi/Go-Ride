{
  "entities": {
    "User": {
      "title": "User",
      "description": "Customer account profile stored in Firestore",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "minLength": 10,
          "maxLength": 20,
          "pattern": "^(\\+92|0)?3[0-9]{2}[\\s\\-]?[0-9]{7}$"
        },
        "role": {
          "type": "string",
          "enum": ["customer", "admin"]
        },
        "profileImage": {
          "type": "string",
          "maxLength": 16384,
          "pattern": "^(|(https?://|/src/|data:image/(jpeg|jpg|png|webp);base64,).*)$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "fullName", "email", "phone", "role", "createdAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized GoRide administrator record",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["admin", "super_admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "name", "email", "role", "createdAt"]
    },
    "Vehicle": {
      "title": "Vehicle",
      "description": "Bookable car or bike in the GoRide fleet",
      "type": "object",
      "properties": {
        "vehicleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "type": {
          "type": "string",
          "enum": ["car", "bike"]
        },
        "model": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "seats": {
          "type": "number"
        },
        "pricePerKm": {
          "type": "number"
        },
        "baseFare": {
          "type": "number"
        },
        "availability": {
          "type": "string",
          "enum": ["Available", "On Trip", "Maintenance"]
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 500
        },
        "plateNumber": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24
        },
        "city": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["vehicleId", "name", "type", "model", "seats", "pricePerKm", "baseFare", "availability", "imageUrl", "createdAt"]
    },
    "Driver": {
      "title": "Driver",
      "description": "Verified driver/rider assigned to bookings by admins",
      "type": "object",
      "properties": {
        "driverId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "minLength": 10,
          "maxLength": 20
        },
        "vehicleType": {
          "type": "string",
          "enum": ["car", "bike"]
        },
        "licenseNumber": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40
        },
        "availability": {
          "type": "string",
          "enum": ["Available", "Assigned", "Off Duty"]
        },
        "rating": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["driverId", "fullName", "phone", "vehicleType", "licenseNumber", "availability", "createdAt"]
    },
    "FareConfig": {
      "title": "FareConfig",
      "description": "Admin-managed global fare rates in PKR",
      "type": "object",
      "properties": {
        "carBaseFare": {
          "type": "number"
        },
        "carPerKm": {
          "type": "number"
        },
        "bikeBaseFare": {
          "type": "number"
        },
        "bikePerKm": {
          "type": "number"
        },
        "minimumFare": {
          "type": "number"
        },
        "peakMultiplier": {
          "type": "number"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["carBaseFare", "carPerKm", "bikeBaseFare", "bikePerKm", "minimumFare", "peakMultiplier", "updatedAt"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Car or bike ride booking with route metrics and lifecycle status",
      "type": "object",
      "properties": {
        "bookingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "customerPhone": {
          "type": "string",
          "minLength": 10,
          "maxLength": 20
        },
        "vehicleType": {
          "type": "string",
          "enum": ["car", "bike"]
        },
        "vehicleId": {
          "type": "string",
          "maxLength": 128
        },
        "vehicleName": {
          "type": "string",
          "maxLength": 100
        },
        "assignedDriverId": {
          "type": "string",
          "maxLength": 128
        },
        "assignedDriverName": {
          "type": "string",
          "maxLength": 100
        },
        "assignedDriverPhone": {
          "type": "string",
          "maxLength": 20
        },
        "pickupLocation": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        },
        "pickupLat": {
          "type": "number"
        },
        "pickupLng": {
          "type": "number"
        },
        "destination": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        },
        "destLat": {
          "type": "number"
        },
        "destLng": {
          "type": "number"
        },
        "pickupDate": {
          "type": "string",
          "minLength": 8,
          "maxLength": 20
        },
        "pickupTime": {
          "type": "string",
          "minLength": 4,
          "maxLength": 10
        },
        "distance": {
          "type": "number"
        },
        "durationMinutes": {
          "type": "number"
        },
        "fare": {
          "type": "number"
        },
        "specialInstructions": {
          "type": "string",
          "maxLength": 400
        },
        "status": {
          "type": "string",
          "enum": ["Pending", "Accepted", "Rejected", "Driver Assigned", "In Progress", "Completed", "Cancelled"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "bookingId",
        "customerId",
        "customerName",
        "customerPhone",
        "vehicleType",
        "pickupLocation",
        "destination",
        "pickupDate",
        "pickupTime",
        "distance",
        "fare",
        "status",
        "createdAt"
      ]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app booking status notification for customers or admins",
      "type": "object",
      "properties": {
        "notificationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "bookingId": {
          "type": "string",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "message": {
          "type": "string",
          "minLength": 2,
          "maxLength": 400
        },
        "type": {
          "type": "string",
          "enum": ["info", "success", "warning", "error"]
        },
        "read": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["notificationId", "userId", "title", "message", "type", "read", "createdAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Private customer profiles (PII-protected by owner or admin)"
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Authorized admin accounts"
    },
    "/vehicles/{vehicleId}": {
      "schema": { "$ref": "#/entities/Vehicle" },
      "description": "Fleet cars and bikes available for booking"
    },
    "/drivers/{driverId}": {
      "schema": { "$ref": "#/entities/Driver" },
      "description": "Fleet drivers/riders assignable to bookings"
    },
    "/fareConfig/{configId}": {
      "schema": { "$ref": "#/entities/FareConfig" },
      "description": "Global PKR fare rate configuration"
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Ride bookings created by customers and managed by admins"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Real-time in-app booking notifications"
    }
  }
}
